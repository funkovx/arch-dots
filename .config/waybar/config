{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 4,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["idle_inhibitor", "clock"],
    "modules-right": [
        "temperature",
        "pulseaudio",
        "hyprland/language",
        "network",
        "backlight",
        "battery",
        "custom/quick-settings"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "on-click": "activate"
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 25,
        "separate-outputs": true
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {"activated": "", "deactivated": ""},
        "tooltip": true
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%A, %d %B %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "on-click-right": "mode"
        }
    },

    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "format": "{temperatureC}°C",
        "critical-threshold": 80,
        "format-critical": "{temperatureC}°C",
        "tooltip-format": "CPU: {temperatureC}°C",
        "interval": 5,
        "tooltip": true
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": {"default": ["󰕿", "󰖀", "󰕾"]},
        "on-click": "~/.config/waybar/scripts/quick-settings.py sound",
        "tooltip-format": "Volume: {volume}%"
    },

    "backlight": {
        "format": "☀",
        "on-click": "~/.config/waybar/scripts/quick-settings.py brightness",
        "on-scroll-up": "brightnessctl s +1%",
        "on-scroll-down": "brightnessctl s 1%-",
        "tooltip-format": "Brightness: {percent}%"
    },

    "hyprland/language": {
        "format": "{}",
        "format-en": "EN",
        "format-ru": "RU"
    },

    "network": {
        "format-wifi": "{icon}",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid} · {signalStrength}%\n{ipaddr}",
        "on-click": "~/.config/waybar/scripts/quick-settings.py wifi"
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "󰁹 {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "tooltip-format": "Battery: {capacity}% · {timeTo}",
        "on-click": "~/.config/waybar/scripts/quick-settings.py power"
    },

    "custom/quick-settings": {
        "format": "󰒓",
        "tooltip": "Quick settings",
        "exec": "nmcli -w 10 device wifi rescan >/dev/null 2>&1; printf ready",
        "interval": 60,
        "on-click": "~/.config/waybar/scripts/quick-settings.py"
    }
}
