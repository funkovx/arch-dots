{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 4,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": [
        "custom/claude-limits",
        "cpu",
        "memory",
        "pulseaudio",
        "hyprland/language",
        "network",
        "backlight",
        "battery"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "on-click": "activate"
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 25,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%A, %d %B %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "on-scroll": 1,
            "on-click-right": "mode"
        }
    },

    "cpu": {
        "format": "cpu {usage}%",
        "tooltip": false,
        "interval": 2
    },

    "memory": {
        "format": "mem {}%",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
        "interval": 5
    },

    "pulseaudio": {
        "format": "vol {volume}%",
        "format-muted": "vol muted",
        "on-click": "pavucontrol",
        "tooltip": false
    },

    "backlight": {
        "format": "☀ {percent}%",
        "on-scroll-up": "brightnessctl s +1%",
        "on-scroll-down": "brightnessctl s 1%-",
        "tooltip": false
    },

    "hyprland/language": {
        "format": "kb {}",
        "format-en": "US",
        "format-ru": "RU"
    },

    "network": {
        "format-wifi": "wifi {signalStrength}%",
        "format-ethernet": "eth",
        "format-disconnected": "offline",
        "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}",
        "on-click": "nmcli device wifi rescan && kitty --class nmtui-float -e sh -c 'export NEWT_COLORS=\"root=black,black;window=gray,lightgray;textbox=gray,lightgray;button=black,lightgray;compactbutton=gray,lightgray;listbox=gray,lightgray;actlistbox=gray,lightgray;actsellistbox=lightgray,black;entry=gray,lightgray;checkbox=gray,lightgray;actcheckbox=lightgray,black\" && nmtui connect'"
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "bat {capacity}%",
        "format-charging": "chg {capacity}%",
        "format-plugged": "plug {capacity}%",
        "tooltip-format": "{timeTo}"
    },

    "custom/claude-limits": {
        "exec": "~/.config/waybar/scripts/claude-limits.py",
        "return-type": "json",
        "interval": 60,
        "tooltip": true,
        "format": "{}",
        "on-click": "xdg-open https://claude.ai/settings/usage"
    }
}
