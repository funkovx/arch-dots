configuration {
    modi:            "drun,run,window";
    show-icons:      true;
    icon-theme:      "Papirus-Dark";
    drun-display-format: "{name}";
    display-drun:    " Apps";
    display-run:     " Run";
    display-window:  " Windows";
    terminal:        "kitty";
}

@theme "~/.config/rofi/themes/gruvbox-dark.rasi"
